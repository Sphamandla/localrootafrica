# Production environment — copy to .env on the server and fill in real values.
# Base Craft settings: see .env.example.dev

CRAFT_ENVIRONMENT=production
CRAFT_DEV_MODE=false
CRAFT_ALLOW_ADMIN_CHANGES=false
CRAFT_DISALLOW_ROBOTS=false

# Public site URL (no trailing slash)
PRIMARY_SITE_URL=https://localroots.africa

# Database
CRAFT_DB_DRIVER=mysql
CRAFT_DB_SERVER=127.0.0.1
CRAFT_DB_PORT=3306
CRAFT_DB_DATABASE=
CRAFT_DB_USER=
CRAFT_DB_PASSWORD=

# PayFast — live credentials from https://www.payfast.co.za/
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=false

# Ozow — from https://dash.ozow.com/
OZOW_SITE_CODE=
OZOW_API_KEY=
OZOW_PRIVATE_KEY=
OZOW_SANDBOX=false

# Yoco — from https://portal.yoco.com/
YOCO_SECRET_KEY=
YOCO_PUBLIC_KEY=
YOCO_WEBHOOK_SECRET=
YOCO_SANDBOX=false

# The Courier Guy
COURIER_GUY_API_KEY=
COURIER_GUY_API_URL=https://api.thecourierguy.co.za
COURIER_GUY_TEST_MODE=false
COURIER_GUY_FALLBACK_RATE=99
COURIER_GUY_ORIGIN_POSTCODE=8001

# Mailchimp newsletter
MAILCHIMP_API_KEY=
MAILCHIMP_LIST_ID=

# Contact form recipient
CONTACT_TO_EMAIL=hello@localroots.africa

# EFT bank details (shown at checkout + confirmation email)
EFT_BANK_NAME=First National Bank
EFT_ACCOUNT_NAME=Local Roots Africa (Pty) Ltd
EFT_ACCOUNT_NUMBER=
EFT_BRANCH_CODE=
EFT_ACCOUNT_TYPE=Cheque

# Cloudflare (optional — cache purge)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_EMAIL=

# Blitz full-page cache
BLITZ_ENABLED=true

# Active coupons (optional)
COUPONS=
