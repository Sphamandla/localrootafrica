# See .env.example.dev for base Craft settings
# Copy this file to .env and configure

PRIMARY_SITE_URL=http://localhost:8080

# PayFast
PAYFAST_MERCHANT_ID=your_id
PAYFAST_MERCHANT_KEY=your_key
PAYFAST_PASSPHRASE=your_passphrase
PAYFAST_TEST_MODE=true
PAYFAST_SANDBOX=true

# Ozow
OZOW_SITE_CODE=your_code
OZOW_API_KEY=your_key
OZOW_TEST_MODE=true
OZOW_PRIVATE_KEY=your_ozow_private_key
OZOW_SANDBOX=true

# Yoco
YOCO_SECRET_KEY=your_secret
YOCO_PUBLIC_KEY=your_public
YOCO_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
YOCO_TEST_MODE=true
YOCO_SANDBOX=true

# The Courier Guy
COURIER_GUY_API_KEY=your_courier_guy_api_key
COURIER_GUY_API_URL=https://api.courierguy.co.za
COURIER_GUY_TEST_MODE=true
COURIER_GUY_FALLBACK_RATE=99
COURIER_GUY_ORIGIN_POSTCODE=8001

# Mailchimp
MAILCHIMP_API_KEY=your_mailchimp_api_key
MAILCHIMP_LIST_ID=your_mailchimp_list_id

# Contact form recipient (defaults to Craft system fromEmail)
CONTACT_TO_EMAIL=

# EFT / bank transfer details (Cash checkout)
EFT_BANK_NAME=First National Bank
EFT_ACCOUNT_NAME=Local Roots Africa (Pty) Ltd
EFT_ACCOUNT_NUMBER=62812345678
EFT_BRANCH_CODE=250655
EFT_ACCOUNT_TYPE=Cheque

# Cloudflare
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ZONE_ID=your_cloudflare_zone_id
CLOUDFLARE_EMAIL=your_cloudflare_email

# Template import
TEMPLATE_HTML_PATH=/Users/test/www/localrootsafrica/innovecouture.vamtam.com

# Coupons (multiple active coupons supported)
# JSON format:
# COUPONS=[{"code":"SAVE10","percent":10,"uses":100,"expires":"2026-12-31"},{"code":"FLAT50","amount":50,"uses":25,"expires":"2026-06-30"}]
# Pipe format (code|percent|uses|expires;code|percent|uses|expires):
# COUPONS=SAVE10|10|100|2026-12-31;WELCOME20|20|50|2026-06-30
COUPONS=

# Blitz
BLITZ_ENABLED=true
