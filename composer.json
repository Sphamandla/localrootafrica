{
  "minimum-stability": "dev",
  "prefer-stable": true,
  "autoload": {
    "psr-4": {
      "modules\\localroots\\": "modules/localroots/"
    }
  },
  "require": {
    "clarknelson/craft-mailchimp": "dev-master",
    "craftcms/cms": "^5.9.0",
    "craftcms/commerce": "^5.0",
    "doublesecretagency/craft-notifier": "^3.2",
    "nystudio107/craft-seomatic": "^5.0",
    "putyourlightson/craft-blitz": "^5.0",
    "putyourlightson/craft-sprig": "^3.7",
    "verbb/wishlist": "^3.0",
    "vlucas/phpdotenv": "^5.4.0"
  },
  "require-dev": {
    "craftcms/generator": "^2.0.0",
    "yiisoft/yii2-shell": "^2.0.3"
  },
  "config": {
    "allow-plugins": {
      "craftcms/plugin-installer": true,
      "yiisoft/yii2-composer": true
    },
    "sort-packages": true,
    "optimize-autoloader": true
  },
  "scripts": {
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example.dev', '.env');\""
    ]
  }
}
