<footer class="site-footer">
    <div class="container">
        <div class="footer-grid">
            <div>
                <a href="/" class="site-logo">
                    <img src="/assets/wp-content/uploads/2023/12/Logo.svg" alt="Local Roots Africa" style="filter: invert(1); height: 19px;">
                </a>
                <p style="margin-top: 16px; color: rgba(255,255,255,0.6); font-size: 13px; max-width: 280px;">
                    Premium fashion and lifestyle. Crafted with care, designed for you.
                </p>
            </div>
            <div>
                <h4>Shop</h4>
                <ul>
                    <li><a href="/shop">All Products</a></li>
                    <li><a href="/shop?category=women">Women</a></li>
                    <li><a href="/shop?category=men">Men</a></li>
                    <li><a href="/shop/sale">Sale</a></li>
                </ul>
            </div>
            <div>
                <h4>Help</h4>
                <ul>
                    <li><a href="/contact">Contact</a></li>
                    <li><a href="/delivery-and-returns">Delivery & Returns</a></li>
                    <li><a href="/faq">FAQ</a></li>
                </ul>
            </div>
            <div>
                <h4>Company</h4>
                <ul>
                    <li><a href="/about">About Us</a></li>
                    <li><a href="/privacy">Privacy Policy</a></li>
                    <li><a href="/terms">Terms of Service</a></li>
                </ul>
            </div>
        </div>

        <div class="footer-bottom">
            <span>{{ footerSettings.copyrightText ?? '© ' ~ now|date('Y') ~ ' Local Roots Africa. All rights reserved.' }}</span>
            <div class="social-links">
                {% if footerSettings.socialInstagram %}<a href="{{ footerSettings.socialInstagram }}" target="_blank" rel="noopener">Instagram</a>{% endif %}
                {% if footerSettings.socialFacebook %}<a href="{{ footerSettings.socialFacebook }}" target="_blank" rel="noopener">Facebook</a>{% endif %}
                {% if footerSettings.socialTwitter %}<a href="{{ footerSettings.socialTwitter }}" target="_blank" rel="noopener">Twitter</a>{% endif %}
                {% if footerSettings.socialPinterest %}<a href="{{ footerSettings.socialPinterest }}" target="_blank" rel="noopener">Pinterest</a>{% endif %}
            </div>
        </div>
    </div>
</footer>
