{# Dynamic checkout — Vamtam Elementor markup matching content-checkout.twig #}
{% set cart = craft.commerce.carts.cart %}
{% set commerceGateways = craft.app.plugins.getPlugin('commerce').getGateways() %}
{% set bankGateway = commerceGateways.getGatewayByHandle('cash-eft') %}
{% set codGateway = commerceGateways.getGatewayByHandle('cash-on-delivery') %}
{% set gateways = [] %}
{% if bankGateway and bankGateway.isFrontendEnabled %}
	{% set gateways = gateways|merge([bankGateway]) %}
{% endif %}
{% if codGateway and codGateway.isFrontendEnabled %}
	{% set gateways = gateways|merge([codGateway]) %}
{% endif %}
{% set shippingRate = craft.app.getModule('localroots').courierGuy.getRateForPostalCode(cart.billingAddress.postalCode ?? null, cart.totalWeight) %}
{% set billing = cart.billingAddress %}
{% set shipping = cart.shippingAddress %}
{% set shipDifferent = shipping and shipping.addressLine1 and billing and shipping.addressLine1 != billing.addressLine1 %}

<form name="checkout" method="post" class="checkout woocommerce-checkout localroots-checkout-form" action="{{ url('checkout') }}" enctype="multipart/form-data" aria-label="Checkout">
	{{ csrfInput() }}
	{{ actionInput('commerce/payments/pay') }}
	{{ redirectInput(url('checkout/success') ~ '?number={order.number}&email={order.email}') }}
	{{ hiddenInput('cancelUrl', url('checkout/canceled')|hash) }}

<div class="e-checkout__container">
<div class="e-checkout__column e-checkout__column-start">

{% if not currentUser %}
<div class="e-woocommerce-login-section">
	<div class="elementor-woocommerce-login-messages"></div>
	<div class="woocommerce-form-login-toggle e-checkout-secondary-title">
		Returning customer? <a href="{{ url('login') }}" class="e-show-login">Click here to login</a>
	</div>
</div>
{% endif %}

<div class="col2-set" id="customer_details">
<div class="col-1">
<div class="woocommerce-billing-fields">
	<h3>Billing Details</h3>
	<div class="woocommerce-billing-fields__field-wrapper">
		<p class="form-row form-row-first validate-required" id="billing_first_name_field">
			<label for="billing_first_name" class="required_field">First Name&nbsp;<span class="required" aria-hidden="true">*</span></label>
			<span class="woocommerce-input-wrapper"><input type="text" class="input-text" name="billingAddress[firstName]" id="billing_first_name" placeholder="First Name" value="{{ billing.firstName ?? currentUser.firstName ?? '' }}" required autocomplete="given-name" /></span>
		</p>
		<p class="form-row form-row-last validate-required" id="billing_last_name_field">
			<label for="billing_last_name" class="required_field">Last Name&nbsp;<span class="required" aria-hidden="true">*</span></label>
			<span class="woocommerce-input-wrapper"><input type="text" class="input-text" name="billingAddress[lastName]" id="billing_last_name" placeholder="Last Name" value="{{ billing.lastName ?? currentUser.lastName ?? '' }}" required autocomplete="family-name" /></span>
		</p>
		<p class="form-row form-row-wide" id="billing_company_field">
			<label for="billing_company">Company Name&nbsp;<span class="optional">(optional)</span></label>
			<span class="woocommerce-input-wrapper"><input type="text" class="input-text" name="billingAddress[organization]" id="billing_company" placeholder="Company Name" value="{{ billing.organization ?? '' }}" autocomplete="organization" /></span>
		</p>
		<p class="form-row form-row-wide address-field update_totals_on_change elementor-field-group validate-required" id="billing_country_field">
			<label for="billing_country" class="required_field">Country / Region&nbsp;<span class="required" aria-hidden="true">*</span></label>
			<span class="woocommerce-input-wrapper elementor-select-wrapper">
				<select name="billingAddress[countryCode]" id="billing_country" class="country_to_state country_select elementor-field-textual" required autocomplete="country">
					<option value="ZA" selected>South Africa</option>
				</select>
			</span>
		</p>
		<p class="form-row form-row-wide address-field validate-required" id="billing_address_1_field">
			<label for="billing_address_1" class="required_field">Street address&nbsp;<span class="required" aria-hidden="true">*</span></label>
			<span class="woocommerce-input-wrapper"><input type="text" class="input-text" name="billingAddress[addressLine1]" id="billing_address_1" placeholder="House number and street name" value="{{ billing.addressLine1 ?? '' }}" required autocomplete="address-line1" /></span>
		</p>
		<p class="form-row form-row-wide address-field" id="billing_address_2_field">
			<label for="billing_address_2" class="screen-reader-text">Apartment, suite, unit, etc.&nbsp;<span class="optional">(optional)</span></label>
			<span class="woocommerce-input-wrapper"><input type="text" class="input-text" name="billingAddress[addressLine2]" id="billing_address_2" placeholder="Apartment, suite, unit, etc. (optional)" value="{{ billing.addressLine2 ?? '' }}" autocomplete="address-line2" /></span>
		</p>
		<p class="form-row form-row-wide address-field validate-required" id="billing_city_field">
			<label for="billing_city" class="required_field">Town / City&nbsp;<span class="required" aria-hidden="true">*</span></label>
			<span class="woocommerce-input-wrapper"><input type="text" class="input-text" name="billingAddress[locality]" id="billing_city" value="{{ billing.locality ?? '' }}" required autocomplete="address-level2" /></span>
		</p>
		<p class="form-row form-row-wide address-field validate-required validate-postcode" id="billing_postcode_field">
			<label for="billing_postcode" class="required_field">Postcode / ZIP&nbsp;<span class="required" aria-hidden="true">*</span></label>
			<span class="woocommerce-input-wrapper"><input type="text" class="input-text" name="billingAddress[postalCode]" id="billing_postcode" value="{{ billing.postalCode ?? '' }}" required autocomplete="postal-code" /></span>
		</p>
		<p class="form-row form-row-wide validate-required validate-phone" id="billing_phone_field">
			<label for="billing_phone" class="required_field">Phone&nbsp;<span class="required" aria-hidden="true">*</span></label>
			<span class="woocommerce-input-wrapper"><input type="tel" class="input-text" name="billingAddress[phone]" id="billing_phone" placeholder="Phone" value="" required autocomplete="tel" /></span>
		</p>
		<p class="form-row form-row-wide validate-required validate-email" id="billing_email_field">
			<label for="billing_email" class="required_field">Email Address&nbsp;<span class="required" aria-hidden="true">*</span></label>
			<span class="woocommerce-input-wrapper"><input type="email" class="input-text" name="email" id="billing_email" placeholder="Email Address" value="{{ cart.email ?? currentUser.email ?? '' }}" required autocomplete="email" /></span>
		</p>
	</div>
</div>

{% if not currentUser %}
<div class="woocommerce-account-fields">
	<p class="form-row form-row-wide create-account">
		<label class="woocommerce-form__label woocommerce-form__label-for-checkbox checkbox">
			<input class="woocommerce-form__input woocommerce-form__input-checkbox input-checkbox" id="createaccount" type="checkbox" name="registerUserOnOrderComplete" value="1"{% if cart.registerUserOnOrderComplete %} checked="checked"{% endif %} />
			<span>Create an account?</span>
		</label>
	</p>
	<p class="form-row form-row-wide localroots-create-account-note" id="createaccount_note"{% if not cart.registerUserOnOrderComplete %} style="display:none"{% endif %}>
		<small>We’ll email you a link to set your password after your order is placed.</small>
	</p>
</div>
{% endif %}
</div>

<div class="col-2">
<div class="woocommerce-shipping-fields">
	<h3 id="ship-to-different-address">
		<label class="woocommerce-form__label woocommerce-form__label-for-checkbox checkbox">
			<input id="ship-to-different-address-checkbox" class="woocommerce-form__input woocommerce-form__input-checkbox input-checkbox" type="checkbox" name="shipToDifferentAddress" value="1"{% if shipDifferent %} checked="checked"{% endif %} />
			<span>Ship to a different address?</span>
		</label>
	</h3>
	<div class="shipping_address"{% if not shipDifferent %} style="display:none"{% endif %}>
		<div class="woocommerce-shipping-fields__field-wrapper">
			<p class="form-row form-row-first validate-required" id="shipping_first_name_field">
				<label for="shipping_first_name" class="required_field">First Name&nbsp;<span class="required" aria-hidden="true">*</span></label>
				<span class="woocommerce-input-wrapper"><input type="text" class="input-text" name="shippingAddress[firstName]" id="shipping_first_name" placeholder="First Name" value="{{ shipping.firstName ?? billing.firstName ?? '' }}" autocomplete="shipping given-name" /></span>
			</p>
			<p class="form-row form-row-last validate-required" id="shipping_last_name_field">
				<label for="shipping_last_name" class="required_field">Last Name&nbsp;<span class="required" aria-hidden="true">*</span></label>
				<span class="woocommerce-input-wrapper"><input type="text" class="input-text" name="shippingAddress[lastName]" id="shipping_last_name" placeholder="Last Name" value="{{ shipping.lastName ?? billing.lastName ?? '' }}" autocomplete="shipping family-name" /></span>
			</p>
			<p class="form-row form-row-wide address-field update_totals_on_change elementor-field-group validate-required" id="shipping_country_field">
				<label for="shipping_country" class="required_field">Country / Region&nbsp;<span class="required" aria-hidden="true">*</span></label>
				<span class="woocommerce-input-wrapper elementor-select-wrapper">
					<select name="shippingAddress[countryCode]" id="shipping_country" class="country_to_state country_select elementor-field-textual" autocomplete="shipping country">
						<option value="ZA" selected>South Africa</option>
					</select>
				</span>
			</p>
			<p class="form-row form-row-wide address-field validate-required" id="shipping_address_1_field">
				<label for="shipping_address_1" class="required_field">Street address&nbsp;<span class="required" aria-hidden="true">*</span></label>
				<span class="woocommerce-input-wrapper"><input type="text" class="input-text" name="shippingAddress[addressLine1]" id="shipping_address_1" placeholder="House number and street name" value="{{ shipping.addressLine1 ?? billing.addressLine1 ?? '' }}" autocomplete="shipping address-line1" /></span>
			</p>
			<p class="form-row form-row-wide address-field" id="shipping_address_2_field">
				<label for="shipping_address_2" class="screen-reader-text">Apartment, suite, unit, etc.&nbsp;<span class="optional">(optional)</span></label>
				<span class="woocommerce-input-wrapper"><input type="text" class="input-text" name="shippingAddress[addressLine2]" id="shipping_address_2" placeholder="Apartment, suite, unit, etc. (optional)" value="{{ shipping.addressLine2 ?? billing.addressLine2 ?? '' }}" autocomplete="shipping address-line2" /></span>
			</p>
			<p class="form-row form-row-wide address-field validate-required" id="shipping_city_field">
				<label for="shipping_city" class="required_field">Town / City&nbsp;<span class="required" aria-hidden="true">*</span></label>
				<span class="woocommerce-input-wrapper"><input type="text" class="input-text" name="shippingAddress[locality]" id="shipping_city" value="{{ shipping.locality ?? billing.locality ?? '' }}" autocomplete="shipping address-level2" /></span>
			</p>
			<p class="form-row form-row-wide address-field validate-required validate-postcode" id="shipping_postcode_field">
				<label for="shipping_postcode" class="required_field">Postcode / ZIP&nbsp;<span class="required" aria-hidden="true">*</span></label>
				<span class="woocommerce-input-wrapper"><input type="text" class="input-text" name="shippingAddress[postalCode]" id="shipping_postcode" value="{{ shipping.postalCode ?? billing.postalCode ?? '' }}" autocomplete="shipping postal-code" /></span>
			</p>
			<p class="form-row form-row-wide validate-required validate-phone validate-tel" id="shipping_phone_field">
				<label for="shipping_phone" class="required_field">Phone&nbsp;<span class="required" aria-hidden="true">*</span></label>
				<span class="woocommerce-input-wrapper"><input type="tel" class="input-text" name="shippingAddress[phone]" id="shipping_phone" value="" autocomplete="tel" /></span>
			</p>
		</div>
	</div>
</div>
<div class="woocommerce-additional-fields">
	<div class="woocommerce-additional-fields__field-wrapper">
		<p class="form-row notes" id="order_comments_field">
			<label for="order_comments">Order notes&nbsp;<span class="optional">(optional)</span></label>
			<span class="woocommerce-input-wrapper"><textarea name="message" class="input-text" id="order_comments" placeholder="Notes about your order, e.g. special notes for delivery." rows="2" cols="5">{{ cart.message ?? '' }}</textarea></span>
		</p>
	</div>
</div>
</div>
</div>

</div>

<div class="e-checkout__column e-checkout__column-end">
<div class="e-checkout__column-inner e-sticky-right-column">
<div class="e-checkout__order_review">
	<h3 id="order_review_heading">Order Summary</h3>
	<div id="order_review" class="woocommerce-checkout-review-order">
		<table class="shop_table woocommerce-checkout-review-order-table">
			<thead>
				<tr>
					<th class="product-name">Product</th>
					<th class="product-total">Subtotal</th>
				</tr>
			</thead>
			<tbody>
				{% for item in cart.lineItems %}
				<tr class="cart_item">
					<td class="product-name">{{ item.description }}&nbsp;<strong class="product-quantity">&times;&nbsp;{{ item.qty }}</strong></td>
					<td class="product-total">{% include '_includes/vamtam/price.twig' with { amount: item.total } %}</td>
				</tr>
				{% endfor %}
			</tbody>
			<tfoot>
				<tr class="cart-subtotal">
					<th>Subtotal</th>
					<td>{% include '_includes/vamtam/price.twig' with { amount: cart.itemSubtotal } %}</td>
				</tr>
				<tr class="woocommerce-shipping-totals shipping">
					<th>Shipment</th>
					<td data-title="Shipment">
						<ul id="shipping_method" class="woocommerce-shipping-methods">
							<li>
								<input type="radio" name="shipping_method[0]" data-index="0" id="shipping_method_0_courier_guy" value="courier_guy" class="shipping_method localroots-shipping-method" checked="checked" />
								<label for="shipping_method_0_courier_guy">The Courier Guy — <span id="localroots-shipping-cost">{% include '_includes/vamtam/price.twig' with { amount: shippingRate } %}</span></label>
							</li>
							<li>
								<input type="radio" name="shipping_method[0]" data-index="0" id="shipping_method_0_local_pickup" value="local_pickup" class="shipping_method localroots-shipping-method" />
								<label for="shipping_method_0_local_pickup">Local pickup: {% include '_includes/vamtam/price.twig' with { amount: 0 } %}</label>
							</li>
						</ul>
					</td>
				</tr>
				{% if cart.totalDiscount > 0 %}
				<tr class="cart-discount">
					<th>Discount{% if cart.couponCode %} ({{ cart.couponCode }}){% endif %}</th>
					<td>-{% include '_includes/vamtam/price.twig' with { amount: cart.totalDiscount } %}</td>
				</tr>
				{% endif %}
				{% if cart.totalTax > 0 %}
				<tr class="tax-total">
					<th>VAT</th>
					<td>{% include '_includes/vamtam/price.twig' with { amount: cart.totalTax } %}</td>
				</tr>
				{% endif %}
				<tr class="order-total">
					<th>Total</th>
					<td><strong id="localroots-order-total">{% include '_includes/vamtam/price.twig' with { amount: cart.totalPrice + shippingRate } %}</strong></td>
				</tr>
			</tfoot>
		</table>
	</div>
</div>

<div class="e-coupon-box">
	<p class="e-woocommerce-coupon-nudge e-checkout-secondary-title">Have a coupon? <a href="#" class="e-show-coupon-form">Click here to enter your coupon code</a></p>
	<div class="e-coupon-anchor" style="display:none">
		<label class="e-coupon-anchor-description">If you have a coupon code, please apply it below.</label>
		<div class="form-row">
			<div class="coupon-container-grid">
				<div class="col coupon-col-1">
					<input type="text" name="couponCode" class="input-text" placeholder="Coupon code" id="coupon_code" value="{{ cart.couponCode ?? '' }}" />
				</div>
				<div class="col coupon-col-2">
					<button class="woocommerce-button button e-apply-coupon localroots-apply-coupon" type="button">Apply</button>
				</div>
			</div>
		</div>
		<p class="localroots-coupon-message" style="display:none"></p>
		<div class="clear"></div>
	</div>
</div>

<div class="e-checkout__order_review-2">
	<div id="payment" class="woocommerce-checkout-payment">
		<ul class="wc_payment_methods payment_methods methods" aria-label="Payment methods">
			{% for gateway in gateways %}
			<li class="wc_payment_method payment_method_{{ gateway.handle }}">
				<input id="payment_method_{{ gateway.handle }}" type="radio" class="input-radio localroots-gateway-radio" name="gatewayId" value="{{ gateway.id }}" data-order_button_text="Place order"{% if loop.first %} checked="checked"{% endif %} />
				<label for="payment_method_{{ gateway.handle }}">{{ gateway.name }}</label>
				<div class="payment_box payment_method_{{ gateway.handle }}"{% if not loop.first %} style="display:none"{% endif %}>
					{{ gateway.getPaymentFormHtml({})|raw }}
				</div>
			</li>
			{% endfor %}
		</ul>
		<div class="form-row place-order">
			<noscript>
				Since your browser does not support JavaScript, or it is disabled, please ensure you click the <em>Update Totals</em> button before placing your order.
			</noscript>
			<div class="woocommerce-terms-and-conditions-wrapper">
				<p class="form-row validate-required">
					<label class="woocommerce-form__label woocommerce-form__label-for-checkbox checkbox">
						<input type="checkbox" class="woocommerce-form__input woocommerce-form__input-checkbox input-checkbox" name="terms" id="terms" required />
						<span class="woocommerce-terms-and-conditions-checkbox-text">I have read and agree to the website <a href="/terms-and-conditions" class="woocommerce-terms-and-conditions-link" target="_blank">terms and conditions</a></span>&nbsp;<abbr class="required" title="required">*</abbr>
					</label>
				</p>
			</div>
			<button type="submit" class="button alt" name="woocommerce_checkout_place_order" id="place_order" value="Place order" data-value="Place order">Place order</button>
		</div>
	</div>
</div>

</div>
</div>
</div>
</form>
