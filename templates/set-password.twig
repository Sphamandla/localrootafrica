{% extends '_layouts/vamtam' %}

{% block head %}
{% include '_includes/vamtam/head-account.twig' %}
{% endblock %}

{% block bodyClass %}{% include '_static/body-class-account.twig' %}{% endblock %}

{% block content %}
{% if craft.app.session.hasFlash('notice') %}
<div class="localroots-flash localroots-flash--notice" role="status" style="max-width:1280px;margin:0 auto 1rem;padding:0.75rem 1rem;background:#eef6ee;color:#1e4620;border:1px solid #c8e6c9;">{{ craft.app.session.getFlash('notice') }}</div>
{% endif %}
{% if craft.app.session.hasFlash('error') %}
<div class="localroots-flash localroots-flash--error" role="alert" style="max-width:1280px;margin:0 auto 1rem;padding:0.75rem 1rem;background:#fdecea;color:#611a15;border:1px solid #f5c6cb;">{{ craft.app.session.getFlash('error') }}</div>
{% endif %}
{% if craft.app.session.hasFlash('success') %}
<div class="localroots-flash localroots-flash--notice" role="status" style="max-width:1280px;margin:0 auto 1rem;padding:0.75rem 1rem;background:#eef6ee;color:#1e4620;border:1px solid #c8e6c9;">{{ craft.app.session.getFlash('success') }}</div>
{% endif %}

<div id="page" class="main-container">
<div id="main-content">
<div id="sub-header" class="layout-full elementor-page-title"><div class="meta-header"></div></div>
<div id="main" role="main" class="vamtam-main layout-full">
<div class="page-wrapper">
<article id="post-8" class="full post-8 page type-page status-publish hentry">
<div class="page-content clearfix the-content-parent">
<div data-elementor-type="wp-page" data-elementor-id="8" class="elementor elementor-8">
<div class="elementor-element elementor-element-7edda15 e-flex e-con-boxed e-con e-parent">
<div class="e-con-inner">
<div class="elementor-element elementor-element-b0463ac elementor-widget elementor-widget-heading">
<div class="elementor-widget-container">
<h1 class="elementor-heading-title elementor-size-default">{% if newUser ?? false %}Activate your account{% else %}Reset password{% endif %}</h1>
</div>
</div>
<div class="vamtam-has-theme-widget-styles elementor-element elementor-element-9b0b2c2 e-my-account-tabs-horizontal elementor-widget elementor-widget-woocommerce-my-account localroots-account-ready">
<div class="elementor-widget-container">
<div class="e-my-account-tab e-my-account-tab__dashboard">
<div class="woocommerce">
<form method="post" class="woocommerce-ResetPassword lost_reset_password" accept-charset="UTF-8">
{{ csrfInput() }}
{{ actionInput('users/set-password') }}
<input type="hidden" name="code" value="{{ code }}">
<input type="hidden" name="id" value="{{ id }}">
{{ redirectInput('account') }}

<p>{% if newUser ?? false %}Create a password to activate your account.{% else %}Enter a new password below.{% endif %}</p>

{% if errors is defined %}
<div class="woocommerce-error" role="alert">
{% for error in errors %}
<p>{{ error }}</p>
{% endfor %}
</div>
{% endif %}

<p class="woocommerce-form-row woocommerce-form-row--wide form-row form-row-wide">
<label for="newPassword">New password&nbsp;<span class="required">*</span></label>
<input type="password" class="woocommerce-Input woocommerce-Input--text input-text" name="newPassword" id="newPassword" autocomplete="new-password" required minlength="6">
</p>
<p class="woocommerce-form-row form-row">
<button type="submit" class="woocommerce-Button button">Save password</button>
</p>
</form>
</div>
</div>
</div>
</div>
</div>
</div>
</div>
</div>
</article>
</div>
</div>
</div>
</div>
{% endblock %}
