{% extends '_layouts/vamtam-alt' %}

{% block head %}{% include '_includes/vamtam/head-brands.twig' %}{% endblock %}
{% block bodyClass %}{% include '_static/body-class-brands.twig' %}{% endblock %}

{% block content %}
<style>
/* Match reference post-3101: 5 columns on desktop, 3 on tablet, 2 on mobile */
.elementor-3101 .localroots-brand-column {
	--display: flex;
	--flex-direction: column;
	--flex-grow: 0;
	--flex-shrink: 0;
	--width: 20%;
	flex: 0 0 20%;
	max-width: 20%;
	width: 20%;
	box-sizing: border-box;
	padding-right: 10px;
}

.elementor-3101 .localroots-brand-column .elementor-heading-title {
	font-size: inherit;
	line-height: 1.6;
}

.elementor-3101 .localroots-brand-column .elementor-heading-title a {
	text-decoration: none;
}

.elementor-3101 .localroots-brand-column .elementor-heading-title a:hover {
	opacity: 0.7;
}

@media (max-width: 1024px) and (min-width: 768px) {
	.elementor-3101 .localroots-brand-column {
		--width: 33.333%;
		flex: 0 0 33.333%;
		max-width: 33.333%;
		width: 33.333%;
	}
}

@media (max-width: 767px) {
	.elementor-3101 .localroots-brand-column {
		--width: 50%;
		flex: 0 0 50%;
		max-width: 50%;
		width: 50%;
		padding-right: 0;
	}
}
</style>
{% include '_static/content-brands.twig' %}
{% endblock %}
