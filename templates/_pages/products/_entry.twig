{% extends '_layouts/vamtam' %}

{% set variants = product.variants.all() %}
{% set isVariable = variants|length > 1 and not (product.simplePurchase ?? false) %}
{% set productHandle = 'product-' ~ product.slug %}
{% set contentTemplate = craft.app.view.doesTemplateExist('_static/content-' ~ productHandle ~ '.twig')
	? '_static/content-' ~ productHandle ~ '.twig'
	: (isVariable ? '_static/content-product.twig' : '_static/content-product-simple.twig') %}
{% set bodyClassTemplate = craft.app.view.doesTemplateExist('_static/body-class-' ~ productHandle ~ '.twig')
	? '_static/body-class-' ~ productHandle ~ '.twig'
	: (isVariable ? '_static/body-class-product.twig' : '_static/body-class-product-simple.twig') %}

{% set variant = product.defaultVariant ?? variants|first %}
{% set images = product.productImages.all() %}
{% set primaryImage = images|first %}
{% set fallbackImage = '/wp-content/uploads/2024/02/4302405505_1_1_1.jpg' %}
{% set imageUrl = primaryImage ? primaryImage.getUrl() : fallbackImage %}
{% set imageThumb = primaryImage ? primaryImage.getUrl({ width: 866, height: 1299 }) : fallbackImage %}
{% set thumb150 = primaryImage ? primaryImage.getUrl({ width: 150, height: 150, mode: 'crop' }) : fallbackImage %}
{% set salePrice = variant ? variant.salePrice : 0 %}
{% set regularPrice = variant ? variant.price : 0 %}
{% set onSale = variant and variant.onPromotion and regularPrice > salePrice %}
{% set priceValues = [] %}
{% for v in variants %}
	{% set priceValues = priceValues|merge([v.salePrice]) %}
{% endfor %}
{% set minPrice = priceValues|sort|first|default(0) %}
{% set maxPrice = priceValues|sort|last|default(0) %}
{% set shortDescription = product.productShortDescription ?? product.title %}
{% set relatedProducts = craft.products()
	.relatedTo(product.productCategories)
	.id('not ' ~ product.id)
	.limit(4)
	.all() %}
{% set productSku = variant.sku ?? product.defaultSku ?? '' %}

{% set reviewService = craft.app.getModule('localroots').productReviews %}
{% set currentUser = currentUser ?? null %}
{% set reviewTokenParam = craft.app.request.getQueryParam('review') %}
{% set tokenData = reviewTokenParam ? reviewService.validateToken(reviewTokenParam, product.id) : null %}
{% set hasPurchased = tokenData ? true : (currentUser ? reviewService.hasPurchased(product.id, currentUser.id) : false) %}
{% set alreadyReviewed = (currentUser and reviewService.hasExistingReview(product.id, currentUser.id)) or (tokenData and reviewService.hasExistingReview(product.id, null, tokenData.email)) %}
{% set canReview = hasPurchased and not alreadyReviewed %}
{% set reviewStats = reviewService.getReviewStats(product.id) %}
{% set reviews = craft.entries()
	.section('productReviews')
	.reviewProduct(product)
	.reviewStatus('approved')
	.orderBy('dateCreated desc')
	.all() %}
{% set questions = craft.entries()
	.section('productQuestions')
	.questionProduct(product)
	.questionStatus('answered')
	.orderBy('dateCreated desc')
	.all() %}

{% block head %}
{% include '_includes/vamtam/head-product.twig' %}
{% endblock %}

{% block bodyClass %}{% include bodyClassTemplate %}{% endblock %}

{% block content %}
{% if craft.app.session.hasFlash('notice') %}
<div class="localroots-flash localroots-flash--notice" role="status" style="max-width:1200px;margin:0 auto 1rem;padding:0.75rem 1rem;background:#eef6ee;color:#1e4620;border:1px solid #c8e6c9;">{{ craft.app.session.getFlash('notice') }}</div>
{% endif %}
{% if craft.app.session.hasFlash('error') %}
<div class="localroots-flash localroots-flash--error" role="alert" style="max-width:1200px;margin:0 auto 1rem;padding:0.75rem 1rem;background:#fdecea;color:#611a15;border:1px solid #f5c6cb;">{{ craft.app.session.getFlash('error') }}</div>
{% endif %}
<div id="localroots-product-sources" hidden>
	<div id="localroots-product-price-source">
		{% include '_includes/vamtam/product-page-price.twig' with { product: product, variants: variants, variant: variant } %}
	</div>
	<div id="localroots-product-cart-source">
		{% if isVariable %}
		{% include '_includes/vamtam/product-variable-cart.twig' with { product: product, variants: variants } %}
		{% else %}
		{% include '_includes/vamtam/product-simple-cart.twig' with { product: product, variant: variant } %}
		{% endif %}
	</div>
	<div id="localroots-related-source">
		{% for related in relatedProducts %}
			{% include '_includes/vamtam/product-related-item-13500.twig' with { product: related } %}
		{% endfor %}
	</div>
	<div id="localroots-product-reviews-source">
		<div id="localroots-review-list">
			{% include '_includes/vamtam/product-review-items.twig' with { reviews: reviews } %}
		</div>
		<div id="localroots-review-form">
			{% include '_includes/vamtam/product-review-form.twig' with {
				product: product,
				canReview: canReview,
				currentUser: currentUser,
				reviewToken: reviewTokenParam
			} %}
		</div>
	</div>
	<div id="localroots-product-qa-source">
		<div id="localroots-qa-form">
			{% include '_includes/vamtam/product-qa-form.twig' with { product: product, currentUser: currentUser } %}
		</div>
		<div id="localroots-qa-list">
			{% include '_includes/vamtam/product-qa-items.twig' with { questions: questions } %}
		</div>
	</div>
</div>

<script type="application/json" id="localroots-product-config">
{
	"title": {{ product.title|json_encode|raw }},
	"id": {{ product.id }},
	"onSale": {{ onSale ? 'true' : 'false' }},
	"minPrice": {{ minPrice|round }},
	"maxPrice": {{ maxPrice|round }},
	"isVariable": {{ isVariable ? 'true' : 'false' }},
	"cartWidgetId": {{ (isVariable ? '48216332' : '9f21477')|json_encode|raw }},
	"galleryWidgetId": {{ (isVariable ? '12b6582' : '99c187b')|json_encode|raw }},
	"stickyWidgetId": {{ (isVariable ? '478d184f' : 'ae78bb3')|json_encode|raw }},
	"priceWidgetId": {{ (isVariable ? '7aef695f' : '55aa537')|json_encode|raw }},
	"salePrice": {{ salePrice|round }},
	"regularPrice": {{ regularPrice|round }},
	"description": {{ shortDescription|json_encode|raw }},
	"descriptionHtml": {{ (product.productShortDescription ?? '')|json_encode|raw }},
	"additionalInfoHtml": {{ ''|json_encode|raw }},
	"sku": {{ productSku|json_encode|raw }},
	"categories": [
		{% for cat in product.productCategories.all() %}
		{{ cat.title|json_encode|raw }}{% if not loop.last %},{% endif %}
		{% endfor %}
	],
	"tags": [
		{% for tag in product.productTags.all() %}
		{{ tag.title|json_encode|raw }}{% if not loop.last %},{% endif %}
		{% endfor %}
	],
	"imageUrl": {{ imageUrl|json_encode|raw }},
	"imageThumb": {{ imageThumb|json_encode|raw }},
	"thumb150": {{ thumb150|json_encode|raw }},
	"url": {{ product.url|json_encode|raw }},
	"reviewCount": {{ reviewStats.count }},
	"reviewAverage": {{ reviewStats.average }},
	"reviewWidth": {{ reviewStats.width }},
	"canReview": {{ canReview ? 'true' : 'false' }},
	"hasPurchased": {{ hasPurchased ? 'true' : 'false' }},
	"reviewToken": {{ reviewTokenParam|json_encode|raw }},
	"images": [
		{% for image in images %}
		{
			"url": {{ image.getUrl()|json_encode|raw }},
			"thumb": {{ image.getUrl({ width: 866, height: 1299 })|json_encode|raw }},
			"alt": {{ product.title|json_encode|raw }}
		}{% if not loop.last %},{% endif %}
		{% else %}
		{
			"url": {{ imageUrl|json_encode|raw }},
			"thumb": {{ imageThumb|json_encode|raw }},
			"alt": {{ product.title|json_encode|raw }}
		}
		{% endfor %}
	]
}
</script>

{% include contentTemplate with { product: product, variants: variants } %}
{% endblock %}

{% block scripts %}
{% include '_includes/vamtam/scripts-product.twig' %}
<script src="{{ alias('@web') }}/js/product.js"></script>
{% endblock %}
