{% extends '_layouts/main' %}

{% set variant = product.defaultVariant %}

{% block content %}
<div class="container">
    <div class="product-detail">
        <div class="product-gallery">
            {% if product.productImages|length %}
                {% for image in product.productImages.all() %}
                    <img src="{{ image.getUrl({ width: 800 }) }}" alt="{{ product.title }}" loading="lazy">
                {% endfor %}
            {% else %}
                <img src="/assets/wp-content/uploads/2024/02/20231214_VB_600_2200x-683x1024.jpg" alt="{{ product.title }}">
            {% endif %}
        </div>

        <div class="product-info">
            <h1>{{ product.title }}</h1>
            {% if variant %}
            <p class="product-price">
                {% if variant.onSale %}<del>R{{ variant.price|commerceCurrency('ZAR') }}</del> {% endif %}
                R{{ variant.salePrice|commerceCurrency('ZAR') }}
            </p>
            {% endif %}

            {% if product.productShortDescription %}
            <div class="product-description">{{ product.productShortDescription|nl2br }}</div>
            {% endif %}

            <form method="post" class="add-to-cart-form">
                {{ csrfInput() }}
                {{ actionInput('commerce/cart/update-cart') }}
                {{ hiddenInput('purchasableId', variant.id) }}
                {{ hiddenInput('qty', 1) }}
                <label for="qty" class="visually-hidden">Quantity</label>
                <input type="number" id="qty" name="qty" value="1" min="1" class="qty-input" aria-label="Quantity">
                <button type="submit" class="btn">Add to Bag</button>
            </form>

            {% if product.productCategories|length %}
            <p style="margin-top: 24px; font-size: 13px; color: var(--color-gray);">
                Categories:
                {% for cat in product.productCategories.all() %}
                    <a href="/shop?category={{ cat.slug }}">{{ cat.title }}</a>{% if not loop.last %}, {% endif %}
                {% endfor %}
            </p>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
