{% extends '_layouts/vamtam' %}

{% set variant = product.defaultVariant ?? product.variants.first() %}

{% block bodyClass %}{% include '_static/body-class-product.twig' %}{% endblock %}

{% block content %}
<div id="localroots-atc-source" hidden>
	{% if variant %}
	<form class="cart" method="post">
		{{ csrfInput() }}
		{{ actionInput('commerce/cart/update-cart') }}
		{{ redirectInput(product.url) }}
		{{ hiddenInput('purchasableId', variant.id) }}
		<div class="quantity">
			<label class="screen-reader-text" for="localroots-qty">{{ product.title }} quantity</label>
			<input type="number" id="localroots-qty" class="input-text qty text" name="qty" value="1" min="1" step="1" aria-label="Product quantity" inputmode="numeric" autocomplete="off" />
		</div>
		<button type="submit" class="single_add_to_cart_button button alt">Add to cart</button>
	</form>
	{% endif %}
</div>
{% include '_static/content-product.twig' %}
{% endblock %}

{% block scripts %}
<script>
(function() {
	const title = {{ product.title|json_encode|raw }};
	document.querySelectorAll('.product_title.entry-title').forEach(el => { el.textContent = title; });

	const priceEl = document.querySelector('.elementor-widget-woocommerce-product-price .price');
	{% if variant %}
	if (priceEl) {
		priceEl.innerHTML = '<span class="woocommerce-Price-amount amount"><bdi><span class="woocommerce-Price-currencySymbol" translate="no">R</span>{{ variant.salePrice|number_format(0, '.', '') }}</bdi></span>';
	}
	{% endif %}

	const sourceForm = document.querySelector('#localroots-atc-source form');
	const targetForm = document.querySelector('.elementor-add-to-cart form.cart');
	if (sourceForm && targetForm) {
		targetForm.replaceWith(sourceForm.cloneNode(true));
	}
})();
</script>
{% endblock %}
