{% extends '_layouts/vamtam' %}

{% set shopFilter = craft.app.getModule('localroots').shopFilter %}
{% set categoryPath = craft.app.request.getParam('path') ?? slug ?? null %}
{% set categoryContext = categoryPath ? shopFilter.resolveCategoryPath(categoryPath) : null %}
{% set params = shopFilter.applyCategoryScope(shopFilter.getParams(), categoryContext) %}
{% set facets = shopFilter.getFacets(categoryContext) %}
{% set result = shopFilter.getProducts(params) %}
{% set products = result.products %}
{% set totalProducts = result.total %}
{% set currentPage = result.page %}
{% set totalPages = result.totalPages %}
{% set limit = result.limit %}
{% set basePath = categoryContext ? categoryContext.basePath : 'shop' %}
{% set shopUrl = shopFilter.getCategoryUrl(categoryContext) %}
{% set sortLabels = {
	'date-desc': 'Newest',
	'price-asc': 'Price (low to high)',
	'price-desc': 'Price (high to low)',
	'title-asc': 'Name: A to Z',
	'title-desc': 'Name: Z to A'
} %}
{% set sortLabel = sortLabels[params.sort] ?? 'Default' %}
{% set rangeStart = totalProducts ? ((currentPage - 1) * limit + 1) : 0 %}
{% set rangeEnd = totalProducts ? min(currentPage * limit, totalProducts) : 0 %}

{% block head %}{% include '_includes/vamtam/head-shop.twig' %}{% endblock %}
{% block bodyClass %}{% include '_static/body-class-collection.twig' %}{% endblock %}

{% block content %}
<div id="localroots-shop-sources" hidden>
	<div id="localroots-shop-filters-source">
		{% include '_includes/vamtam/shop-filters.twig' with { facets: facets, params: params, formAction: shopUrl } %}
	</div>
	<div id="localroots-shop-grid-source">
		{% for product in products %}
			{% include '_includes/vamtam/product-loop-item.twig' with { product: product } %}
		{% endfor %}
	</div>
</div>

<script type="application/json" id="localroots-shop-config">
{
	"totalProducts": {{ totalProducts }},
	"currentPage": {{ currentPage }},
	"totalPages": {{ totalPages }},
	"rangeStart": {{ rangeStart }},
	"rangeEnd": {{ rangeEnd }},
	"sort": {{ params.sort|json_encode|raw }},
	"sortLabel": {{ sortLabel|json_encode|raw }},
	"shopUrl": {{ shopUrl|json_encode|raw }},
	"loadMoreUrl": {{ url('localroots/shop/load-more')|json_encode|raw }},
	"categoryPath": {{ (categoryContext.path ?? '')|json_encode|raw }},
	"categoryTitle": {{ (categoryContext.title ?? 'Shop')|json_encode|raw }},
	"categoryBreadcrumb": {{ (categoryContext.breadcrumb ?? [])|json_encode|raw }},
	"priceMin": {{ facets.minPrice|round }},
	"priceMax": {{ facets.maxPrice|round }},
	"sortUrls": {
		"date-desc": {{ shopFilter.buildFilterUrl(params, { sort: 'date-desc', page: 1 }, basePath)|json_encode|raw }},
		"price-asc": {{ shopFilter.buildFilterUrl(params, { sort: 'price-asc', page: 1 }, basePath)|json_encode|raw }},
		"price-desc": {{ shopFilter.buildFilterUrl(params, { sort: 'price-desc', page: 1 }, basePath)|json_encode|raw }},
		"title-asc": {{ shopFilter.buildFilterUrl(params, { sort: 'title-asc', page: 1 }, basePath)|json_encode|raw }},
		"title-desc": {{ shopFilter.buildFilterUrl(params, { sort: 'title-desc', page: 1 }, basePath)|json_encode|raw }}
	},
	"pageUrls": [
		{% for page in 1..totalPages %}
		{{ shopFilter.buildFilterUrl(params, { page: page }, basePath)|json_encode|raw }}{% if not loop.last %},{% endif %}
		{% endfor %}
	]
}
</script>

{% include '_static/content-collection.twig' %}
{% endblock %}

{% block scripts %}
{% include '_includes/vamtam/scripts-shop.twig' %}
<script src="{{ alias('@web') }}/js/shop.js"></script>
{% endblock %}
