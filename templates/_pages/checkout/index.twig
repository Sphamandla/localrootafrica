{% extends '_layouts/vamtam' %}

{% set cart = craft.commerce.carts.cart %}
{% set shippingRate = craft.app.getModule('localroots').courierGuy.getRateForPostalCode(cart.billingAddress.zipCode ?? null, cart.totalWeight) %}

{% block bodyClass %}{% include '_static/body-class-checkout.twig' %}{% endblock %}

{% block content %}
{% if cart.lineItems|length %}
<div id="localroots-checkout-source" hidden>
	{% include '_includes/vamtam/checkout-commerce.twig' %}
</div>
<script type="application/json" id="localroots-checkout-config">
{
	"csrfName": {{ craft.app.config.general.csrfTokenName|json_encode|raw }},
	"csrfToken": {{ craft.app.request.csrfToken|json_encode|raw }},
	"updateCartAction": {{ actionUrl('commerce/cart/update-cart')|json_encode|raw }},
	"trackProgressUrl": {{ url('localroots/checkout/track-progress')|json_encode|raw }},
	"trackAttemptUrl": {{ url('localroots/checkout/track-attempt')|json_encode|raw }},
	"calculateShippingUrl": {{ url('localroots/checkout/calculate-shipping')|json_encode|raw }},
	"subtotal": {{ cart.itemSubtotal }},
	"tax": {{ cart.totalTax }},
	"shippingRate": {{ shippingRate }}
}
</script>
{% include '_static/content-checkout.twig' %}
{% else %}
<div id="page" class="main-container"><div id="main-content"><div id="main" role="main" class="vamtam-main layout-full"><div class="page-wrapper"><p class="woocommerce-info">Your bag is empty. <a href="{{ url('shop') }}">Return to shop</a></p></div></div></div></div>
{% endif %}
{% endblock %}

{% block scripts %}
{% if cart.lineItems|length %}
<script src="{{ alias('@web') }}/js/checkout.js"></script>
{% endif %}
{% endblock %}
