{% set vamtamPages = ['about', 'contact', 'terms-and-conditions', 'faq'] %}
{% extends entry.slug in vamtamPages ? '_layouts/vamtam-alt' : '_layouts/main' %}

{% block head %}
{% if entry.slug == 'contact' %}
{% include '_includes/vamtam/head-contact.twig' %}
<style>
.localroots-flash { max-width: 1200px; margin: 0 auto 1rem; padding: 0.75rem 1rem; font-size: 0.95rem; }
.localroots-flash--notice { background: #eef6ee; color: #1e4620; border: 1px solid #c8e6c9; }
.localroots-flash--error { background: #fdecea; color: #611a15; border: 1px solid #f5c6cb; }
</style>
{% elseif entry.slug == 'terms-and-conditions' %}
{% include '_includes/vamtam/head-terms.twig' %}
{% endif %}
{% endblock %}

{% block bodyClass %}
{% if entry.slug == 'about' %}{% include '_static/body-class-about.twig' %}
{% elseif entry.slug == 'contact' %}{% include '_static/body-class-contact.twig' %}
{% elseif entry.slug == 'terms-and-conditions' %}{% include '_static/body-class-terms.twig' %}
{% elseif entry.slug == 'faq' %}{% include '_static/body-class-faq.twig' %}
{% endif %}
{% endblock %}

{% block content %}
{% if entry.slug == 'contact' %}
{% if craft.app.session.hasFlash('notice') %}
<div class="localroots-flash localroots-flash--notice" role="status">{{ craft.app.session.getFlash('notice') }}</div>
{% endif %}
{% if craft.app.session.hasFlash('error') %}
<div class="localroots-flash localroots-flash--error" role="alert">{{ craft.app.session.getFlash('error') }}</div>
{% endif %}
<div id="localroots-contact-source" hidden>
	<div data-contact-form>
		{% include '_includes/vamtam/contact-form.twig' %}
	</div>
</div>
{% endif %}
{% if entry.slug == 'about' %}
{% include '_static/content-about.twig' %}
{% elseif entry.slug == 'contact' %}
{% include '_static/content-contact.twig' %}
{% elseif entry.slug == 'terms-and-conditions' %}
{% include '_static/content-terms-localroots.twig' %}
{% elseif entry.slug == 'faq' %}
{% include '_pages/faq/_content.twig' with { entry: entry } %}
{% else %}
<div class="container section">
    {% if entry.pageHeroImage|length %}
    <div class="hero" style="height: 40vh; min-height: 300px; margin-bottom: 40px; background-image: linear-gradient(to top, rgba(0,0,0,0.4), transparent), url('{{ entry.pageHeroImage.one().url }}');">
        <div class="hero-content">
            <h1>{{ entry.title }}</h1>
        </div>
    </div>
    {% else %}
    <h1 class="section-title">{{ entry.title }}</h1>
    {% endif %}

    <div style="max-width: 800px; line-height: 1.8; color: var(--color-gray);">
        {{ entry.pageBody|nl2br }}
    </div>
</div>
{% endif %}
{% endblock %}

{% block scripts %}
{% if entry.slug == 'faq' %}
<script src="{{ alias('@web') }}/js/faq.js"></script>
{% elseif entry.slug == 'contact' %}
<script src="{{ alias('@web') }}/js/contact.js"></script>
{% endif %}
{% endblock %}
