{% extends '_layouts/vamtam-alt' %}

{% block bodyClass %}privacy-policy page{% endblock %}

{% block content %}
<div id="page" class="main-container">
	<div id="main-content">
		<div id="main" role="main" class="vamtam-main layout-full">
			<div class="page-wrapper limit-width">
				<div class="page-content the-content entry-content">
					<h1>Privacy Policy</h1>
					<p><strong>Local Roots Africa (Pty) Ltd</strong> (“we”, “us”, “our”) respects your privacy and processes personal information in accordance with the Protection of Personal Information Act, 2013 (POPIA).</p>

					<h2>Information we collect</h2>
					<ul>
						<li>Contact details (name, email, phone number, delivery address)</li>
						<li>Order and payment information required to fulfil your purchase</li>
						<li>Account credentials if you register</li>
						<li>Website usage data via cookies (see our cookie notice)</li>
					</ul>

					<h2>How we use your information</h2>
					<ul>
						<li>Process and deliver orders</li>
						<li>Provide customer support and order updates</li>
						<li>Send marketing communications where you have opted in</li>
						<li>Improve our website and comply with legal obligations</li>
					</ul>

					<h2>Sharing of information</h2>
					<p>We share data only with service providers needed to operate our store (payment gateways, couriers, email delivery) and where required by law. We do not sell your personal information.</p>

					<h2>Retention &amp; security</h2>
					<p>We retain personal information only as long as necessary for the purposes above and apply reasonable technical and organisational safeguards.</p>

					<h2>Your rights</h2>
					<p>You may request access, correction, deletion, or objection to processing of your personal information by contacting <a href="mailto:hello@localroots.africa">hello@localroots.africa</a>.</p>

					<h2>Contact</h2>
					<p>Information Officer: Local Roots Africa<br>
					Email: <a href="mailto:hello@localroots.africa">hello@localroots.africa</a><br>
					Website: <a href="{{ url('/') }}">localroots.africa</a></p>

					<p><em>Last updated: {{ "now"|date('F j, Y') }}</em></p>
				</div>
			</div>
		</div>
	</div>
</div>
{% endblock %}
