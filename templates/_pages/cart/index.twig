{% extends '_layouts/main' %}
{% set cart = craft.commerce.carts.cart %}

{% block content %}
<div class="container section">
    <h1 class="section-title">Shopping Bag</h1>

    {% if cart.lineItems|length %}
    <table class="cart-table">
        <thead>
            <tr>
                <th>Product</th>
                <th>Price</th>
                <th>Qty</th>
                <th>Total</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            {% for item in cart.lineItems %}
            <tr>
                <td>
                    <div style="display: flex; gap: 16px; align-items: center;">
                        {% set product = item.purchasable.product ?? null %}
                        {% if product and product.productImages|length %}
                            <img src="{{ product.productImages.one().getUrl({ width: 160 }) }}" alt="{{ item.description }}">
                        {% endif %}
                        <span>{{ item.description }}</span>
                    </div>
                </td>
                <td>R{{ item.price|commerceCurrency('ZAR') }}</td>
                <td>{{ item.qty }}</td>
                <td>R{{ item.total|commerceCurrency('ZAR') }}</td>
                <td>
                    <form method="post">
                        {{ csrfInput() }}
                        {{ actionInput('commerce/cart/remove-line-item') }}
                        {{ hiddenInput('lineItemId', item.id) }}
                        <button type="submit" style="background:none;border:none;cursor:pointer;text-decoration:underline;font-size:13px;">Remove</button>
                    </form>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>

    <div style="display: flex; justify-content: flex-end; margin-top: 40px; gap: 40px; align-items: center;">
        <p style="font-size: 18px; font-weight: 500;">Total: R{{ cart.totalPrice|commerceCurrency('ZAR') }}</p>
        <a href="/checkout" class="btn">Proceed to Checkout</a>
    </div>
    {% else %}
    <p>Your bag is empty.</p>
    <a href="/shop" class="btn" style="margin-top: 24px;">Continue Shopping</a>
    {% endif %}
</div>
{% endblock %}
