{% extends '_layouts/vamtam' %}

{% block bodyClass %}{% include '_static/body-class-account.twig' %}{% endblock %}

{% block content %}
<div id="page" class="main-container">
<div id="main-content">
<div id="main" role="main" class="vamtam-main layout-full">
<div class="page-wrapper">
<div class="woocommerce">
    <h2>Register</h2>
    <form method="post" accept-charset="UTF-8" class="woocommerce-form woocommerce-form-register register">
        {{ csrfInput() }}
        {{ actionInput('users/save-user') }}
        {{ redirectInput('account') }}
        <p class="form-row">
            <label for="email">Email</label>
            <input type="email" name="email" id="email" required>
        </p>
        <p class="form-row">
            <label for="password">Password</label>
            <input type="password" name="password" id="password" required minlength="6">
        </p>
        <button type="submit" class="button woocommerce-button">Register</button>
    </form>
    <p><a href="/login">Already have an account? Log in</a></p>
</div>
</div>
</div>
</div>
</div>
{% endblock %}
